<Template>
  <!-- CUSTOM: full-track overview preview area pinned at the bottom of the perf
       screen, as a 2x2 grid. Top row = decks 1 | 2 (always). Bottom row =
       decks 3 | 4 (only in 4-deck mode, [Skin],show_4decks) so preview 3 sits
       under preview 1 and preview 4 under preview 2. -->
  <WidgetGroup>
    <ObjectName>CdjBottomDecks</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <!-- Top row: deck 1 | deck 2 -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <MinimumSize>0,84</MinimumSize>
        <Children>
          <Template src="skins:RekordboxPi/decks/cdj_mini_deck.xml">
            <SetVariable name="Group">[Channel1]</SetVariable>
            <SetVariable name="DeckNum">1</SetVariable>
            <SetVariable name="DeckBadgeObj">XdjBadge1</SetVariable>
          </Template>
          <Template src="skins:RekordboxPi/decks/cdj_mini_deck.xml">
            <SetVariable name="Group">[Channel2]</SetVariable>
            <SetVariable name="DeckNum">2</SetVariable>
            <SetVariable name="DeckBadgeObj">XdjBadge2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <!-- Bottom row: deck 3 | deck 4 (only in 4-deck mode) -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <MinimumSize>0,84</MinimumSize>
        <Children>
          <Template src="skins:RekordboxPi/decks/cdj_mini_deck.xml">
            <SetVariable name="Group">[Channel3]</SetVariable>
            <SetVariable name="DeckNum">3</SetVariable>
            <SetVariable name="DeckBadgeObj">XdjBadge1</SetVariable>
          </Template>
          <Template src="skins:RekordboxPi/decks/cdj_mini_deck.xml">
            <SetVariable name="Group">[Channel4]</SetVariable>
            <SetVariable name="DeckNum">4</SetVariable>
            <SetVariable name="DeckBadgeObj">XdjBadge2</SetVariable>
          </Template>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
