<Template>
  <!-- CUSTOM XDJ-AZ preview panel for one deck, modeled on the reference's
       4-Deck View cards: left column = (badge + title + ON AIR) over
       (big REMAIN time | full-track overview); right column = full-height
       white-framed BPM box with Q/TEMPO-RANGE/pitch-% readouts under it.
       No Play/Cue buttons here - this is a preview/overview panel,
       transport is on the hardware/deck strip, not duplicated here.
       Caller: Group, DeckNum, DeckBadgeObj, MiniDeckBoxObj. -->
  <WidgetGroup>
    <ObjectName><Variable name="MiniDeckBoxObj"/></ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <!-- CUSTOM: left column (title row + remain/overview row). The BPM
           column sits beside it and spans the full card height, so its
           digits aren't squashed into the overview row anymore. -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <!-- Row: badge | title | ON AIR -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Label>
                <ObjectName><Variable name="DeckBadgeObj"/></ObjectName>
                <Text><Variable name="DeckNum"/></Text>
                <Size>18f,16f</Size>
              </Label>
              <WidgetGroup><Size>5f,1min</Size></WidgetGroup>
              <!-- CUSTOM: expanding title (full remaining width, elided) -
                   ON AIR is pushed against the row's right end, i.e. right
                   next to the BPM frame, like the reference photo. -->
              <TrackProperty>
                <ObjectName>CdjMiniTitle</ObjectName>
                <Group><Variable name="Group"/></Group>
                <Property>title</Property>
                <ReadOnly>true</ReadOnly>
                <Elide>right</Elide>
                <SizePolicy>me,f</SizePolicy>
              </TrackProperty>
              <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

              <!-- ON AIR badge, lit red while the deck plays (display-only:
                   no ButtonState connection, so touching it does nothing).
                   Sits at the row's right end, margin to the BPM frame is
                   the left column's trailing 6f spacer. -->
              <PushButton>
                <ObjectName>CdjMiniOnAir</ObjectName>
                <Size>44f,16f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>ON AIR</Text></State>
                <State><Number>1</Number><Text>ON AIR</Text></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

          <!-- Row: REMAIN time (big) | overview + phrase bar -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <!-- REMAIN block -->
              <WidgetGroup>
                <ObjectName>CdjMiniTimeBox</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>min,me</SizePolicy>
                <Children>
                  <Label>
                    <ObjectName>CdjMiniTimeLabel</ObjectName>
                    <Text>REMAIN / TIME</Text>
                    <SizePolicy>min,f</SizePolicy>
                  </Label>
                  <NumberPos>
                    <ObjectName>CdjMiniTime</ObjectName>
                    <Group><Variable name="Group"/></Group>
                    <SizePolicy>min,f</SizePolicy>
                    <Alignment>left</Alignment>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                    </Connection>
                  </NumberPos>
                  <WidgetGroup><SizePolicy>min,me</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>

              <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

              <!-- Full-track overview (preview) + phrase-bar placeholder -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skins:RekordboxPi/decks/overview.xml">
                    <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                    <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                    <SetVariable name="OverviewFontSize">8</SetVariable>
                  </Template>
                  <!-- CUSTOM: REAL Rekordbox-style phrase bar - a custom C++
                       widget (WPhraseBar) rendering this track's musical
                       structure sections computed by AnalyzerPhrase (qm-dsp
                       ClusterMeltSegmenter). Sections of the same similarity
                       cluster share a color, like the XDJ-AZ minus the
                       semantic labels. Replaces the earlier static decorative
                       color blocks. -->
                  <PhraseBar>
                    <ObjectName>XdjPhraseBar</ObjectName>
                    <Group><Variable name="Group"/></Group>
                    <SizePolicy>me,f</SizePolicy>
                    <MinimumSize>0,10</MinimumSize>
                    <MaximumSize>-1,10</MaximumSize>
                  </PhraseBar>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup><!-- left column -->

      <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

      <!-- CUSTOM: full-height BPM column, XDJ-AZ style: white framed BPM box
           (frame + digits turn ORANGE while this deck is the sync MASTER),
           then a Q (quantize toggle) + clickable TEMPO RANGE line
           (+-6 / +-10 / +-16 / WIDE), then the current pitch offset in %. -->
      <WidgetGroup>
        <ObjectName>CdjMiniBpmCol</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>min,me</SizePolicy>
        <MinimumSize>78,-1</MinimumSize>
        <MaximumSize>78,-1</MaximumSize>
        <Children>

          <WidgetGroup>
            <ObjectName>CdjMiniBpmBox</ObjectName>
            <Layout>vertical</Layout>
            <!-- CUSTOM: "min" (Minimum) still has Qt's grow flag set, so
                 this box was stretching tall to soak up the column's
                 leftover vertical space instead of the trailing spacer -
                 which pushed the label+digits down/centered inside a much
                 taller white frame than their own content needed. "max"
                 (Maximum) can shrink but never grows past its children's
                 natural height, so the frame now hugs the BPM digits and
                 the freed space actually reaches the Q/range row below. -->
            <SizePolicy>me,max</SizePolicy>
            <Children>
              <!-- Explicit heights everywhere in this column: the card is
                   63px tall and Qt silently squeezes whichever child has no
                   hard height when the sum overflows - which crushed the
                   digits against the frame's bottom edge.
                   CUSTOM: BPM frame shrunk further (label 9->8, digits
                   26->22->19, lift 2->1) to give the Q/TEMPO-RANGE row
                   below it more tap height (11->15->19) - it holds the
                   actual quantize/range buttons. -->
              <Label>
                <ObjectName>CdjMiniBpmLabel</ObjectName>
                <Text>BPM</Text>
                <Size>0me,8f</Size>
                <!-- Orange while this deck is the sync MASTER. Bound on
                     each child too (not just the box): a parent property
                     change doesn't re-polish children, so a descendant
                     QSS selector alone never refreshes their color. -->
                <Connection>
                  <ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </Label>
              <Number>
                <ObjectName>CdjMiniBpm</ObjectName>
                <Size>0me,19f</Size>
                <Alignment>right</Alignment>
                <NumberOfDigits>1</NumberOfDigits>
                <!-- CDJ look: "150" big, ".0" smaller (see wnumber.cpp) -->
                <SmallDecimalsPx>9</SmallDecimalsPx>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </Number>
              <!-- CUSTOM: lifts the digits off the frame's bottom edge. -->
              <WidgetGroup><Size>1min,1f</Size></WidgetGroup>
            </Children>
            <!-- Orange frame + digits while this deck is the sync MASTER -->
            <Connection>
              <ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

          <!-- Q (quantize toggle) | TEMPO RANGE (click cycles the range).
               CUSTOM: hidden with no track loaded - these read a real
               per-deck rate/quantize state, so showing "Q +-8" on an empty
               deck looked like stale data rather than an empty slot. -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <PushButton>
                <ObjectName>CdjMiniQuantize</ObjectName>
                <TooltipId>quantize</TooltipId>
                <Size>14f,19f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>Q</Text></State>
                <State><Number>1</Number><Text>Q</Text></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
              <WidgetGroup>
                <Layout>stacked</Layout>
                <SizePolicy>min,min</SizePolicy>
                <Children>
                  <!-- invisible click-catcher over the range readout:
                       each press cycles rateRange like a CDJ's TEMPO
                       RANGE button (rate_range_cycle, ratecontrol.cpp) -->
                  <PushButton>
                    <ObjectName>CdjMiniRateRangeTap</ObjectName>
                    <Size>36f,19f</Size>
                    <NumberStates>1</NumberStates>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,rate_range_cycle</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                  <RateRange>
                    <ObjectName>CdjMiniRateRange</ObjectName>
                    <TooltipId>rate_range_display</TooltipId>
                    <Size>36f,19f</Size>
                    <Alignment>right</Alignment>
                    <Group><Variable name="Group"/></Group>
                    <Display>cdj</Display>
                    <NumberOfDigits>0</NumberOfDigits>
                  </RateRange>
                </Children>
              </WidgetGroup>
            </Children>
            <Connection>
              <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

          <!-- Current pitch offset, like the reference's "+2.40%".
               CUSTOM: hidden with no track loaded (see note above). -->
          <WidgetGroup>
            <ObjectName>CdjMiniRatePercentRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
              <NumberRate>
                <ObjectName>CdjMiniBpmRate</ObjectName>
                <TooltipId>rate_display</TooltipId>
                <Size>46f,11f</Size>
                <Alignment>right</Alignment>
                <Group><Variable name="Group"/></Group>
                <NumberOfDigits>2</NumberOfDigits>
              </NumberRate>
              <Label>
                <ObjectName>CdjMiniBpmRatePercentSign</ObjectName>
                <Text>%</Text>
                <Size>8f,11f</Size>
              </Label>
            </Children>
            <Connection>
              <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

          <WidgetGroup><SizePolicy>min,me</SizePolicy></WidgetGroup>
        </Children>
      </WidgetGroup><!-- CdjMiniBpmCol -->

    </Children>
    <!-- Only meaningful on the top row's boxes (XdjMiniBoxTopLeft/TopRight):
         true when the bottom row (decks 3/4) is hidden, i.e. this box is
         actually the last visible row and needs its own closing bottom
         border/radius. Harmless no-op on the bottom row's boxes. -->
    <Connection>
      <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
      <Transform><Not/></Transform>
      <BindProperty>isLastVisible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
