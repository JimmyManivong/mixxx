<Template>
  <!-- CUSTOM XDJ-AZ preview panel for one deck, modeled on the reference's
       4-Deck View cards: row 1 = badge + title + stopgap Play/Cue + ON AIR
       badge; row 2 = big REMAIN time | full-track overview | big framed BPM.
       Small grey labels + big white values, exactly like the hardware.
       Caller: Group, DeckNum, DeckBadgeObj, MiniDeckBoxObj. -->
  <WidgetGroup>
    <ObjectName><Variable name="MiniDeckBoxObj"/></ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <!-- Row: badge | title | Play | Cue | ON AIR -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Label>
            <ObjectName><Variable name="DeckBadgeObj"/></ObjectName>
            <Text><Variable name="DeckNum"/></Text>
            <Size>18f,16f</Size>
          </Label>
          <WidgetGroup><Size>5f,1min</Size></WidgetGroup>
          <TrackProperty>
            <ObjectName>CdjMiniTitle</ObjectName>
            <Group><Variable name="Group"/></Group>
            <Property>title</Property>
            <ReadOnly>true</ReadOnly>
            <Elide>right</Elide>
            <SizePolicy>me,f</SizePolicy>
          </TrackProperty>
          <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

          <!-- Play (toggle) -->
          <PushButton>
            <ObjectName>CdjMiniPlay</ObjectName>
            <Size>30f,16f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>&#9654;</Text></State>
            <State><Number>1</Number><Text>&#10073;&#10073;</Text></State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <!-- Cue (momentary) -->
          <PushButton>
            <ObjectName>CdjMiniCue</ObjectName>
            <Size>32f,16f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>CUE</Text></State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>6f,1min</Size></WidgetGroup>
          <!-- ON AIR badge, lit red while the deck plays (display-only:
               no ButtonState connection, so touching it does nothing). -->
          <PushButton>
            <ObjectName>CdjMiniOnAir</ObjectName>
            <Size>44f,16f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>ON AIR</Text></State>
            <State><Number>1</Number><Text>ON AIR</Text></State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <!-- Row: REMAIN time (big) | overview + phrase bar | BPM (big, framed) -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <!-- REMAIN block -->
          <WidgetGroup>
            <ObjectName>CdjMiniTimeBox</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <Label>
                <ObjectName>CdjMiniTimeLabel</ObjectName>
                <Text>REMAIN / TIME</Text>
                <SizePolicy>min,f</SizePolicy>
              </Label>
              <NumberPos>
                <ObjectName>CdjMiniTime</ObjectName>
                <Group><Variable name="Group"/></Group>
                <SizePolicy>min,f</SizePolicy>
                <Alignment>left</Alignment>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                </Connection>
              </NumberPos>
              <WidgetGroup><SizePolicy>min,me</SizePolicy></WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

          <!-- Full-track overview (preview) + phrase-bar placeholder -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <Template src="skins:RekordboxPi/decks/overview.xml">
                <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                <SetVariable name="OverviewFontSize">8</SetVariable>
              </Template>
              <!-- CUSTOM: reserved slot for a future Rekordbox-style phrase bar
                   (song-structure segments) below the preview overview. -->
              <WidgetGroup>
                <ObjectName>XdjPhraseBarPlaceholder</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,6</MinimumSize>
                <MaximumSize>-1,6</MaximumSize>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>6f,1min</Size></WidgetGroup>

          <!-- Big framed BPM block with tiny -/+ nudge, like the reference's
               boxed BPM readout on each 4-Deck View card. -->
          <WidgetGroup>
            <ObjectName>CdjMiniBpmBox</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <Label>
                <ObjectName>CdjMiniBpmLabel</ObjectName>
                <Text>BPM</Text>
                <SizePolicy>min,f</SizePolicy>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>min,f</SizePolicy>
                <Children>
                  <PushButton>
                    <ObjectName>CdjMiniBpmDown</ObjectName>
                    <Size>14f,14f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Text>&#8722;</Text></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,beats_adjust_slower</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                  <Number>
                    <ObjectName>CdjMiniBpm</ObjectName>
                    <SizePolicy>min,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <NumberOfDigits>1</NumberOfDigits>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                    </Connection>
                  </Number>
                  <PushButton>
                    <ObjectName>CdjMiniBpmUp</ObjectName>
                    <Size>14f,14f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Text>+</Text></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,beats_adjust_faster</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup><SizePolicy>min,me</SizePolicy></WidgetGroup>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

    </Children>
    <!-- Only meaningful on the top row's boxes (XdjMiniBoxTopLeft/TopRight):
         true when the bottom row (decks 3/4) is hidden, i.e. this box is
         actually the last visible row and needs its own closing bottom
         border/radius. Harmless no-op on the bottom row's boxes. -->
    <Connection>
      <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
      <Transform><Not/></Transform>
      <BindProperty>isLastVisible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
