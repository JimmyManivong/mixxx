<Template>
  <!-- CUSTOM Rekordbox / XDJ-AZ deck info strip (M3 glow-up).
       Card with: deck number badge, title/artist, KEY + BPM blocks (labelled),
       TIME + mini overview. Transport stays on the FLX6 hardware.
       Caller SetVariable: Group (e.g. [Channel1]), DeckNum (1/2),
       DeckBadgeObj (XdjBadge1/XdjBadge2 -> badge colour in QSS). -->
  <WidgetGroup>
    <ObjectName>XdjDeckStrip</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <!-- Row 1: badge | title/artist | KEY | BPM -->
      <WidgetGroup>
        <ObjectName>XdjStripRow1</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,44</MinimumSize>
        <MaximumSize>-1,50</MaximumSize>
        <Children>

          <Label>
            <ObjectName><Variable name="DeckBadgeObj"/></ObjectName>
            <Text><Variable name="DeckNum"/></Text>
            <Size>30f,30f</Size>
          </Label>

          <WidgetGroup><Size>9f,1min</Size></WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <!-- CUSTOM: titre + temps sur la même ligne. Le titre s'élide
                   ("...") si trop long pour laisser la place au temps. -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <Children>
                  <!-- CUSTOM: full-width strip now (one deck per row), so the title
                       stretches and elides instead of using Ignored width. -->
                  <TrackProperty>
                    <ObjectName>XdjTitle</ObjectName>
                    <Group><Variable name="Group"/></Group>
                    <Property>title</Property>
                    <Elide>right</Elide>
                    <SizePolicy>me,f</SizePolicy>
                  </TrackProperty>
                  <WidgetGroup><Size>8f,1min</Size></WidgetGroup>
                  <NumberPos>
                    <ObjectName>XdjTime</ObjectName>
                    <!-- CUSTOM FIX: WNumberPos reads time_elapsed/time_remaining
                         from this Group. Without <Group> the group was empty and
                         the time stayed stuck at 0 on both decks. -->
                    <Group><Variable name="Group"/></Group>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                    </Connection>
                  </NumberPos>
                </Children>
              </WidgetGroup>
              <TrackProperty>
                <ObjectName>XdjArtist</ObjectName>
                <Group><Variable name="Group"/></Group>
                <Property>artist</Property>
                <Elide>right</Elide>
                <SizePolicy>me,f</SizePolicy>
              </TrackProperty>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>

          <!-- KEY block -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>max,me</SizePolicy>
            <Children>
              <Label><ObjectName>XdjLabel</ObjectName><Text>KEY</Text><SizePolicy>max,f</SizePolicy></Label>
              <Key>
                <ObjectName>XdjKey</ObjectName>
                <Group><Variable name="Group"/></Group>
                <SizePolicy>max,f</SizePolicy>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
                </Connection>
                <!-- CUSTOM: light up blue when harmonically compatible with
                     another deck (key_compatible CO from KeyCompatibilityIndicator). -->
                <Connection>
                  <ConfigKey><Variable name="Group"/>,key_compatible</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </Key>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>16f,1min</Size></WidgetGroup>

          <!-- BPM block -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>max,me</SizePolicy>
            <Children>
              <Label><ObjectName>XdjLabel</ObjectName><Text>BPM</Text><SizePolicy>max,f</SizePolicy></Label>
              <Number>
                <ObjectName>XdjBpm</ObjectName>
                <SizePolicy>max,f</SizePolicy>
                <Alignment>right</Alignment>
                <NumberOfDigits>2</NumberOfDigits>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                </Connection>
              </Number>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>

        </Children>
      </WidgetGroup>

      <!-- Row 2: mini overview waveform pleine largeur (le TIME est remonté
           à côté du titre en Row 1, style Rekordbox). -->
      <WidgetGroup>
        <ObjectName>XdjStripRow2</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <Template src="skins:RekordboxPi/decks/overview.xml">
            <SetVariable name="Group"><Variable name="Group"/></SetVariable>
            <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
            <SetVariable name="OverviewFontSize">9</SetVariable>
          </Template>

        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
