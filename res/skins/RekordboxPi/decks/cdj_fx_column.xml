          </PushButton>
          <WidgetGroup><Size>2f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,14</MinimumSize>
            <MaximumSize>-1,14</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>3</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>3</Text><Alignment>center</Alignment></State>
