<Template>
  <!-- CUSTOM Rekordbox/XDJ-AZ "BEAT FX" panel - position-for-position copy
       of the XDJ-AZ reference screenshot (user's Desktop), mapped element
       by element:
         "BEAT FX" label (outside the frame)
         [white-bordered box]
           BPM number + "AUTO"/"BPM" badge, top-right of the number
           Effect name, huge/bold/centered/flat (like "DELAY")
           CH SELECT: one segmented control, thin dividers, selected =
             solid white fill + black text (not individual buttons)
           TIME label + value + unit, single row
           "X-PAD PARAMETER" label + filled "BEAT" bar (hardware's touch
             X-Pad mode indicator - no Mixxx equivalent, kept purely for
             visual fidelity, non-interactive)
           Division row, single row of the 6 shown on the reference
             (1/16-1); the extra 4/8/16/32 range we support goes in a
             smaller secondary row since the hardware crop doesn't show
             where/if it appears there
         [end white border - ZOOM/GRID below it on the reference are
          waveform-zoom controls, a different section, out of scope here]
       ONE shared effect unit (EffectRack1_EffectUnit1) assignable to any
       channel via CH SELECT, matching the real hardware's single Beat FX
       engine (not two independent FX1/FX2 racks).
       LEVEL/MIX knobs dropped entirely per user direction - the reference
       doesn't show them on this screen at all (real potentiometers on
       the hardware); ON/OFF has no reference equivalent either (a
       physical button) so it's tucked as a tiny badge in the outer
       header strip, not inside the bordered box. -->
  <WidgetGroup>
    <ObjectName>XdjFxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>max,me</SizePolicy>
    <MinimumSize>150,0</MinimumSize>
    <MaximumSize>150,-1</MaximumSize>
    <Children>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <!-- "BEAT FX" - outside/above the bordered box -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,14</MinimumSize>
        <MaximumSize>-1,14</MaximumSize>
        <Children>
          <WidgetGroup><Size>1me,0min</Size></WidgetGroup>
          <Label>
            <ObjectName>XdjFxSectionLabel</ObjectName>
            <Text>BEAT FX</Text>
            <Alignment>center</Alignment>
            <SizePolicy>max,f</SizePolicy>
          </Label>
          <WidgetGroup><Size>1me,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOnSmall</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>22,12</MinimumSize>
            <MaximumSize>22,12</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,3f</Size></WidgetGroup>

      <!-- ═══════ White-bordered box (everything below to the division
           row lives inside this single frame, like the reference) ═══════ -->
      <WidgetGroup>
        <ObjectName>XdjFxBorderedBox</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <WidgetGroup><Size>1min,4me</Size></WidgetGroup>

          <!-- BPM (big) + AUTO/BPM badge stacked top-right of the number -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,26</MinimumSize>
            <MaximumSize>-1,26</MaximumSize>
            <Children>
              <WidgetGroup><Size>1me,0min</Size></WidgetGroup>
              <!-- CUSTOM: follows CH SELECT below - one Number per channel,
                   only the one whose group_[ChannelN]_enable is on shows
                   (matches the real XDJ-AZ, where this readout tracks
                   whichever deck is currently assigned to Beat FX). Was
                   hardcoded to [Channel1] before, so switching CH SELECT
                   never updated it. -->
              <WidgetGroup>
                <Layout>stacked</Layout>
                <SizePolicy>max,f</SizePolicy>
                <Children>
                  <Number>
                    <ObjectName>XdjFxBpm</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Connection>
                      <ConfigKey>[Channel1],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Number>
                  <Number>
                    <ObjectName>XdjFxBpm</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Connection>
                      <ConfigKey>[Channel2],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Number>
                  <Number>
                    <ObjectName>XdjFxBpm</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Connection>
                      <ConfigKey>[Channel3],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Number>
                  <Number>
                    <ObjectName>XdjFxBpm</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Connection>
                      <ConfigKey>[Channel4],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Number>
                </Children>
              </WidgetGroup>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <WidgetGroup>
                <ObjectName>XdjFxAutoBadgeBox</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>max,f</SizePolicy>
                <Children>
                  <Label>
                    <ObjectName>XdjFxAutoBadge</ObjectName>
                    <Text>AUTO</Text>
                    <Alignment>center</Alignment>
                    <SizePolicy>max,f</SizePolicy>
                  </Label>
                  <Label>
                    <ObjectName>XdjFxBpmLabel</ObjectName>
                    <Text>BPM</Text>
                    <Alignment>center</Alignment>
                    <SizePolicy>max,f</SizePolicy>
                  </Label>
                </Children>
              </WidgetGroup>
              <WidgetGroup><Size>1min,0min</Size></WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1min,6me</Size></WidgetGroup>

          <!-- Effect name - huge, bold, centered, flat (like "DELAY").
               prev/next arrows are nearly invisible, flanking the name. -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,26</MinimumSize>
            <MaximumSize>-1,26</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjFxStepBtn</ObjectName>
                <Size>10f,24f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#9664;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1_Effect1],prev_effect</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <EffectSelector>
                <ObjectName>XdjFxName</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,26</MinimumSize>
                <MaximumSize>-1,26</MaximumSize>
                <EffectRack>1</EffectRack>
                <EffectUnit>1</EffectUnit>
                <Effect>1</Effect>
              </EffectSelector>
              <PushButton>
                <ObjectName>XdjFxStepBtn</ObjectName>
                <Size>10f,24f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#9654;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1_Effect1],next_effect</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1min,8me</Size></WidgetGroup>

          <!-- CH SELECT - one segmented control (shared border, thin
               dividers), no label text above it (the reference doesn't
               have one) - selected cell fills solid white/black.
               CUSTOM: mutually exclusive like the real hardware - each
               button keeps its native POWERWINDOW toggle (NumberStates=2,
               unmodified) but ALSO writes to the other 4 channels' enable
               keys through a <Not/> transform: ControlWidgetConnection::
               setControlParameter runs each connection's transformInverse
               on the SAME emitted toggle value before writing it to that
               connection's own key, so clicking an unselected channel
               turns it on and forces every other channel off in the same
               click.
               Each cross connection also sets ConnectValueToWidget=false.
               Without it, LegacySkinParser::setupConnections picks the
               LAST ButtonState=LeftButton connection with DIR_TO_WIDGET as
               the button's display/highlight source (see
               pLastLeftOrNoButtonConnection) - since these cross
               connections come after the real one in document order, the
               highlight silently latched onto !Master_enable (via its own
               <Not/>) instead of this button's own channel, so every
               button but MST appeared permanently "selected" regardless
               of its actual state. ConnectValueToWidget=false keeps them
               write-only so the own-channel connection stays the display
               source.
               Known edge case: re-clicking the ALREADY selected channel
               toggles it off and (via the same cross wiring) turns every
               other channel on instead of leaving nothing selected -
               acceptable since normal use is always "click a different
               channel to switch", never "click the active one again". -->
          <WidgetGroup>
            <ObjectName>XdjFxSegmented</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,22</MinimumSize>
            <MaximumSize>-1,22</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjFxSeg</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>1</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>XdjFxSeg</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>2</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>2</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>XdjFxSeg</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>3</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>3</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>XdjFxSeg</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>4</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>4</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>XdjFxSegLast</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>MST</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>MST</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                  <Transform><Not/></Transform>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
