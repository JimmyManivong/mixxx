<Template>
  <!-- BEAT FX hardware panel as ONE column spanning the full height of the
       perf stack (all decks), placed once as a sibling of the deck stack -
       not nested inside any single deck's row. The FLX6 only has 2 real
       effect engines (FX1 = EffectUnit1, FX2 = EffectUnit2). Decks 3/4 have
       no on-screen FX panel at all (no hardware control reaches
       EffectUnit3/4).
       CUSTOM: CH SELECT is a SINGLE row governing both FX1 and FX2 together
       (each button toggles both EffectUnit1's and EffectUnit2's routing for
       that channel) - having two separate identical CH SELECT rows, one per
       effect unit, was pure duplication in practice: FX1/FX2 are always
       aimed at whichever deck is playing, never split across two different
       channels. One row frees up vertical space for taller, easier-to-tap
       FX1/FX2 on/off buttons. -->
  <WidgetGroup>
    <ObjectName>XdjFxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>max,me</SizePolicy>
    <MinimumSize>150,0</MinimumSize>
    <MaximumSize>150,-1</MaximumSize>
    <Children>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <Label>
        <ObjectName>XdjDeckHeader</ObjectName>
        <Text>EFFECT</Text>
        <Alignment>center</Alignment>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,16</MinimumSize>
        <MaximumSize>-1,16</MaximumSize>
      </Label>

      <WidgetGroup><Size>1min,4f</Size></WidgetGroup>

      <!-- ===== CH SELECT - governs FX1 + FX2 together ===== -->
      <Label>
        <ObjectName>XdjBoxLabel</ObjectName>
        <Text>CH SELECT</Text>
        <SizePolicy>me,f</SizePolicy>
        <Alignment>center</Alignment>
        <MinimumSize>0,12</MinimumSize>
        <MaximumSize>-1,12</MaximumSize>
      </Label>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,20</MinimumSize>
        <MaximumSize>-1,20</MaximumSize>
        <Children>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,18</MinimumSize>
            <MaximumSize>-1,18</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>1</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>1</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2],group_[Channel1]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,18</MinimumSize>
            <MaximumSize>-1,18</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>2</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>2</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2],group_[Channel2]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,18</MinimumSize>
            <MaximumSize>-1,18</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>3</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>3</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2],group_[Channel3]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,18</MinimumSize>
            <MaximumSize>-1,18</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>4</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>4</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2],group_[Channel4]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxAssign</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,18</MinimumSize>
            <MaximumSize>-1,18</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MST</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>MST</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2],group_[Master]_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,8f</Size></WidgetGroup>

      <!-- ===== FX1 = EffectRack1_EffectUnit1 ===== -->
      <Label>
        <ObjectName>XdjBoxLabel</ObjectName>
        <Text>FX1</Text>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,12</MinimumSize>
        <MaximumSize>-1,12</MaximumSize>
      </Label>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>1</EffectUnit>
            <Effect>1</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>1</EffectUnit>
            <Effect>2</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect2],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect2],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>1</EffectUnit>
            <Effect>3</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect3],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect3],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,10f</Size></WidgetGroup>

      <!-- ===== FX2 = EffectRack1_EffectUnit2 ===== -->
      <Label>
        <ObjectName>XdjBoxLabel</ObjectName>
        <Text>FX2</Text>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,12</MinimumSize>
        <MaximumSize>-1,12</MaximumSize>
      </Label>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>2</EffectUnit>
            <Effect>1</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect1],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect1],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>2</EffectUnit>
            <Effect>2</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect2],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect2],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,2f</Size></WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,22</MinimumSize>
        <MaximumSize>-1,22</MaximumSize>
        <Children>
          <EffectSelector>
            <ObjectName>XdjFxSelector</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,20</MinimumSize>
            <MaximumSize>-1,20</MaximumSize>
            <EffectRack>1</EffectRack>
            <EffectUnit>2</EffectUnit>
            <Effect>3</Effect>
          </EffectSelector>
          <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>XdjFxOn</ObjectName>
            <SizePolicy>max,f</SizePolicy>
            <MinimumSize>34,20</MinimumSize>
            <MaximumSize>34,20</MaximumSize>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OFF</Text><Alignment>center</Alignment></State>
            <State><Number>1</Number><Text>ON</Text><Alignment>center</Alignment></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect3],enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect3],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,1me</Size></WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
