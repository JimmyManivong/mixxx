              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit2_Effect3],enabled</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,3f</Size></WidgetGroup>

      <!-- CH SELECT for FX2 - mirrors physical CH SELECT LEDs when FX2 is focused -->
