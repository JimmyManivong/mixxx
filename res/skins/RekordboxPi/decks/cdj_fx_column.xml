            <ObjectName>XdjFxTimeLabel</ObjectName>
            <Text>X-PAD PARAMETER</Text>
            <Alignment>center</Alignment>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,12</MinimumSize>
            <MaximumSize>-1,12</MaximumSize>
