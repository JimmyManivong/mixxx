<Template>
  <!-- CUSTOM CDJ/XDJ-AZ left info column, matching the XDJ-AZ reference
       screenshot exactly: colored deck-indicator square + "DECK N" +
       eject, then KEY (with keylock tucked where the reference has an
       unlabeled arrow), BEAT JUMP size, and Q (quantize) as a numeric
       readout - not a boolean toggle button. No SYNC in this column at
       all (confirmed against the reference - the hardware doesn't show
       it here either; sync stays reachable via the FLX6 hardware).
       Tab GRID (beatgrid editing) is additional functionality beyond the
       reference, kept because it's genuinely useful and doesn't cost the
       reference any fidelity (it's a secondary page, not shown by default).
       CUSTOM: all 4 decks' boxes are merged into what reads as ONE
       continuous frame (like the CH SELECT segmented control) instead of
       4 separate boxes with gaps - the header (color square/DECK N/GRID/
       eject) now lives INSIDE the box as its first row, and the box's
       ObjectName is position-aware (DeckBoxObj: First/Second/Third/Last,
       set by cdj_perf_stack.xml) so only the outermost edges get the
       full white border; internal boundaries between decks get a
       dimmer 1px divider instead, exactly like adjacent CH SELECT cells.
       Deck 2's box additionally binds an "isLastVisible" property to
       [Skin],show_4decks so it grows a full bottom border + radius when
       it's actually the last visible deck (2-deck mode) instead of the
       middle one (4-deck mode).
       Caller SetVariable: Group, DeckNum, DeckColorObj (matches
       SignalColor_12/34 per deck pair), DeckBoxObj - all set by
       cdj_perf_stack.xml. -->
  <WidgetGroup>
    <ObjectName>XdjSidebar</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>max,me</SizePolicy>
    <MinimumSize>140,96</MinimumSize>
    <MaximumSize>140,-1</MaximumSize>
    <Children>

      <!-- ══════ TAB 1: DECK controls ══════ -->
      <WidgetGroup>
        <ObjectName>XdjTabDeckContent</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <!-- White-bordered box - same visual language as the Beat FX
               panel (cdj_fx_column.xml XdjFxBorderedBox), merged across
               all 4 decks into one continuous frame (see ObjectName). -->
          <WidgetGroup>
            <ObjectName><Variable name="DeckBoxObj"/></ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <!-- ── Header: color square + DECK N (tab to toggle GRID)
                   + eject - now inside the merged frame ── -->
              <WidgetGroup>
                <ObjectName>XdjTabBar</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,16</MinimumSize>
                <MaximumSize>-1,16</MaximumSize>
                <Children>
                  <Label>
                    <ObjectName><Variable name="DeckColorObj"/></ObjectName>
                    <Text></Text>
                    <Size>10f,10f</Size>
                  </Label>
                  <WidgetGroup><Size>4f,1min</Size></WidgetGroup>
                  <!-- Tab 1 DECK: displayValue=0 (active) when show_grid_edit_N=0 -->
                  <PushButton>
                    <ObjectName>XdjTabNormal</ObjectName>
                    <SizePolicy>me,f</SizePolicy>
                    <MinimumSize>0,16</MinimumSize>
                    <MaximumSize>-1,16</MaximumSize>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>DECK <Variable name="DeckNum"/></Text></State>
                    <State><Number>1</Number><Text>DECK <Variable name="DeckNum"/></Text></State>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
                    </Connection>
                  </PushButton>
                  <!-- Tab 2 GRID: displayValue=1 (active) when show_grid_edit_N=1 -->
                  <PushButton>
                    <ObjectName>XdjTabGrid</ObjectName>
                    <SizePolicy>me,f</SizePolicy>
                    <MinimumSize>0,16</MinimumSize>
                    <MaximumSize>-1,16</MaximumSize>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>GRID</Text></State>
                    <State><Number>1</Number><Text>GRID</Text></State>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>3f,1min</Size></WidgetGroup>
                  <!-- Eject - matches the small eject icon top-right of each deck
                       row on the reference. -->
                  <PushButton>
                    <ObjectName>XdjEject</ObjectName>
                    <Size>16f,16f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Text>&#9167;</Text><Alignment>center</Alignment></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,eject</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>

              <WidgetGroup><Size>1min,2me</Size></WidgetGroup>

              <!-- KEY -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,22</MinimumSize>
                <MaximumSize>-1,22</MaximumSize>
                <Children>
                  <Label>
                    <ObjectName>XdjFxTimeLabel</ObjectName>
                    <Text>KEY</Text>
                    <SizePolicy>max,f</SizePolicy>
                  </Label>
                  <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
                  <Key>
                    <ObjectName>XdjKey</ObjectName>
                    <Group><Variable name="Group"/></Group>
                    <SizePolicy>max,f</SizePolicy>
                    <Alignment>right</Alignment>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,key_compatible</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Key>
                  <WidgetGroup><Size>4f,1min</Size></WidgetGroup>
                  <!-- CUSTOM: keylock toggle - was previously not shown
                       anywhere in this skin, so its state (which affects
                       whether pitch moves with tempo) was
                       invisible/uncontrollable. -->
                  <PushButton>
                    <ObjectName>XdjKeyLock</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <MinimumSize>20,20</MinimumSize>
                    <MaximumSize>20,20</MaximumSize>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>&#128275;</Text><Alignment>center</Alignment></State>
                    <State><Number>1</Number><Text>&#128274;</Text><Alignment>center</Alignment></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,keylock</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,keylock</ConfigKey>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>

              <WidgetGroup><Size>1min,3me</Size></WidgetGroup>

              <!-- BEAT JUMP -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,22</MinimumSize>
                <MaximumSize>-1,22</MaximumSize>
                <Children>
                  <Label>
                    <ObjectName>XdjBoxLabelStacked</ObjectName>
                    <Text>BEAT&#10;JUMP</Text>
                    <SizePolicy>max,f</SizePolicy>
                  </Label>
                  <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
                  <BeatSpinBox>
                    <TooltipId>beatjump_size</TooltipId>
                    <ObjectName>XdjBeatJumpValue</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <MinimumSize>0,20</MinimumSize>
                    <MaximumSize>-1,20</MaximumSize>
                    <Alignment>right</Alignment>
                    <Value><Variable name="Group"/>,beatjump_size</Value>
                  </BeatSpinBox>
                </Children>
              </WidgetGroup>

              <WidgetGroup><Size>1min,3me</Size></WidgetGroup>

              <!-- Q (quantize) - a numeric readout on the reference (Q  1),
                   not a boolean toggle button; still tappable to flip it. -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,20</MinimumSize>
                <MaximumSize>-1,20</MaximumSize>
                <Children>
                  <Label>
                    <ObjectName>XdjQLabel</ObjectName>
                    <Text>Q</Text>
                    <SizePolicy>max,f</SizePolicy>
                  </Label>
                  <WidgetGroup><Size>1me,1min</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>XdjQValue</ObjectName>
                    <SizePolicy>max,f</SizePolicy>
                    <MinimumSize>20,20</MinimumSize>
                    <MaximumSize>20,20</MaximumSize>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>0</Text><Alignment>right</Alignment></State>
                    <State><Number>1</Number><Text>1</Text><Alignment>right</Alignment></State>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>

              <WidgetGroup><Size>1min,2me</Size></WidgetGroup>

            </Children>
            <!-- Only meaningful on deck 2's box (DeckBoxObj=
                 XdjFxBorderedBoxSecond): true when in 2-deck mode, i.e.
                 deck 2 is actually the last visible deck and needs the
                 closing bottom border/radius. Harmless no-op property
                 on the other 3 decks' boxes. -->
            <Connection>
              <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>isLastVisible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <!-- Visible when show_grid_edit_N = 0 -->
        <Connection>
          <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <!-- ══════ TAB 2: GRID EDIT controls ══════ -->
      <WidgetGroup>
        <ObjectName>XdjTabGridContent</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <WidgetGroup><Size>1min,1me</Size></WidgetGroup>

          <!-- Row 1: PLAY · TAP -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjGePlay</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>&#9654;</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>&#10073;&#10073;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>TAP</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,bpm_tap</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0min,2f</Size></WidgetGroup>

          <!-- Row 2: BPM display · LOCK -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
            <Children>
              <Label><ObjectName>XdjGeLabel</ObjectName><Text>BPM</Text><SizePolicy>max,f</SizePolicy></Label>
              <Number>
                <ObjectName>XdjGeBpm</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <Alignment>right</Alignment>
                <NumberOfDigits>2</NumberOfDigits>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                </Connection>
              </Number>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeLock</ObjectName>
                <SizePolicy>max,f</SizePolicy>
                <MinimumSize>28,14</MinimumSize>
                <MaximumSize>28,14</MaximumSize>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>&#128275;</Text><Alignment>center</Alignment></State>
                <State><Number>1</Number><Text>&#128274;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,bpmlock</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0min,2f</Size></WidgetGroup>

          <!-- Row 3: ◄ translate · SET BEAT · translate ► -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#9664;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_translate_earlier</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeSetBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>SET</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_translate_curpos</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#9654;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_translate_later</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0min,2f</Size></WidgetGroup>

          <!-- Row 4: − BPM · + BPM -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#8722; BPM</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_adjust_slower</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>+ BPM</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_adjust_faster</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0min,2f</Size></WidgetGroup>

          <!-- Row 5: x½ · x2 · UNDO -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>0,16</MinimumSize>
            <MaximumSize>-1,16</MaximumSize>
            <Children>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>x&#189;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_set_halve</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>x2</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_set_double</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>3f,0min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>XdjGeBtn</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <MinimumSize>0,14</MinimumSize>
                <MaximumSize>-1,14</MaximumSize>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number><Text>&#8634;</Text><Alignment>center</Alignment></State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,beats_undo_adjustment</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1min,1me</Size></WidgetGroup>

        </Children>
        <!-- Visible when show_grid_edit_N = 1 -->
        <Connection>
          <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="DeckNum"/></ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
