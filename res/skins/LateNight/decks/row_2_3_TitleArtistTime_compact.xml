<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <!-- CUSTOM (Rekordbox layout): small cover art to the left of the title.
           The big spinny that used to sit left of the overview was removed so
           the waveform can span the full width. -->
      <WidgetGroup>
        <ObjectName>TitleCoverArt</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <CoverArt>
            <TooltipId>coverart</TooltipId>
            <Size>46f,46f</Size>
            <Group><Variable name="Group"/></Group>
            <DefaultCover>skins:LateNight/<Variable name="StyleScheme"/>/style/cover_default.svg</DefaultCover>
          </CoverArt>
        </Children>
      </WidgetGroup>
      <WidgetGroup><Size>6f,1min</Size></WidgetGroup><!-- gap -->

      <WidgetGroup>
        <ObjectName>DeckRow_2_3_ArtistTitleTime</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>i,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>TitleRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>i,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>i,me</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>TitleTextCompact</ObjectName>
                    <Size>0me,22f</Size>
                    <TooltipId>track_title</TooltipId>
                    <Property>title</Property>
                    <Alignment>Left</Alignment>
                    <Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

              <!-- CUSTOM: temps à droite du titre, hauteur fixe 22px -->
              <NumberPos>
                <ObjectName>PlayPositionText</ObjectName>
                <TooltipId>track_time</TooltipId>
                <Size>100f,22f</Size>
                <Alignment>right</Alignment>
                <Channel><Variable name="ChanNum"/></Channel>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </NumberPos>

            </Children>
          </WidgetGroup><!-- TitleRow -->

          <WidgetGroup>
            <ObjectName>TrackColorFullCompact</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,2f</Size>
            <Children>
              <TrackWidgetGroup>
                <Size>0me,2f</Size>
                <Group><Variable name="Group"/></Group>
                <TrackColorAlpha>255</TrackColorAlpha>
              </TrackWidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>ArtistRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>ArtistText</ObjectName>
                    <Size>0me,22f</Size>
                    <TooltipId>track_artist</TooltipId>
                    <Property>artist</Property>
                    <Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <ObjectName>DurationGutter</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>max,min</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>DurationText</ObjectName>
                    <TooltipId>track_duration</TooltipId>
                    <Size>0min,22f</Size>
                    <Property>durationTextSeconds</Property>
                    <Channel>
                      <Variable name="ChanNum"/>
                    </Channel>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- ArtistRow -->
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_rate_controls_compact</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup><!-- DeckRow_2_3_ArtistTitleTime -->

    </Children>
  </WidgetGroup>
</Template>
