<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>DeckCompact<Variable name="ChanNum" /></ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>DeckRows2345</ObjectName>
            <SizePolicy>me,min</SizePolicy>
            <Layout>vertical</Layout>
            <Children>
              <WidgetGroup>
                <ObjectName>DeckRows234</ObjectName>
                <SizePolicy>me,min</SizePolicy>
                <!-- "horizontal" for left decks (1/3); "horizontal-reverse"
                     for right decks (2/4) so the row is mirrored. -->
                <Layout>horizontal<Variable name="MirrorReverse"/></Layout>
                <Children>

                  <WidgetGroup>
                    <ObjectName>SpinnyCoverContainer_BigCompact</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>f,f</SizePolicy>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>SpinnyCoverart<Variable name="ChanNum"/></ObjectName>
                      </SingletonContainer>
                    </Children>
                    <Connection>
                      <ConfigKey>[Skin],show_big_spinny_or_cover</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </WidgetGroup><!-- SpinnyCoverContainer_BigCompact -->

                  <WidgetGroup>
                    <SizePolicy>me,min</SizePolicy>
                    <Layout>vertical</Layout>
                    <Children>
                      <Template src="skins:LateNight/decks/row_2_3_TitleArtistTime_compact.xml" />
                      <Template src="skins:LateNight/decks/row_4_overviewSpinny_compact.xml" />
                    </Children>
                  </WidgetGroup>

                  <WidgetGroup>
                    <Size>1f,0min</Size>
                    <Connection>
                      <ConfigKey persist="true">[Skin],show_rate_controls_compact</ConfigKey>
                      <Transform><Not/></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </WidgetGroup>

                </Children>
              </WidgetGroup><!-- DeckRows234 -->

              <!-- CUSTOM (Rekordbox layout): the bottom section. Two view buttons
                   on the LEFT (at hot-cue level) select what fills the rest: the
                   performance pads or the GRID EDIT page. The two views are
                   STACKED so they occupy the exact same area — no size jump when
                   switching tabs. ([Skin],show_grid_edit) -->
              <WidgetGroup>
                <ObjectName>DeckBottomSwitch</ObjectName>
                <!-- "horizontal" for left decks (1/3); "horizontal-reverse"
                     for right decks (2/4): VIEW/GRID buttons move to the
                     right, the pads/grid views to the left. -->
                <Layout>horizontal<Variable name="MirrorReverse"/></Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>

                  <!-- view selector: VIEW (top) / GRID (below), top-aligned -->
                  <WidgetGroup>
                    <ObjectName>DeckViewSwitch</ObjectName>
                    <Layout>vertical</Layout>
                    <SizePolicy>min,me</SizePolicy>
                    <Children>
                      <WidgetGroup><Size>0min,2f</Size></WidgetGroup>
                      <PushButton>
                        <TooltipId>show_grid_edit</TooltipId>
                        <ObjectName>ViewNormalBtn</ObjectName>
                        <Size>44f,32f</Size>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>VIEW</Text><Alignment>center</Alignment>
                          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square_active.svg</Unpressed>
                          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square_active.svg</Pressed>
                        </State>
                        <State><Number>1</Number><Text>VIEW</Text><Alignment>center</Alignment>
                          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square.svg</Unpressed>
                          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square.svg</Pressed>
                        </State>
                        <Connection><ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="ChanNum"/></ConfigKey><ButtonState>LeftButton</ButtonState></Connection>
                      </PushButton>
                      <WidgetGroup><Size>0min,4f</Size></WidgetGroup>
                      <PushButton>
                        <TooltipId>show_grid_edit</TooltipId>
                        <ObjectName>ViewGridBtn</ObjectName>
                        <Size>44f,32f</Size>
                        <NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>GRID</Text><Alignment>center</Alignment>
                          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square.svg</Unpressed>
                          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square.svg</Pressed>
                        </State>
                        <State><Number>1</Number><Text>GRID</Text><Alignment>center</Alignment>
                          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square_active.svg</Unpressed>
                          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="SubRegion_BtnType"/>_square_active.svg</Pressed>
                        </State>
                        <Connection><ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="ChanNum"/></ConfigKey><ButtonState>LeftButton</ButtonState></Connection>
                      </PushButton>
                      <WidgetGroup><Size>0min,1me</Size></WidgetGroup>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>6f,0min</Size></WidgetGroup>

                  <!-- stacked views: pads + grid edit share the exact same area -->
                  <WidgetGroup>
                    <ObjectName>DeckViewsStack</ObjectName>
                    <Layout>stacked</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>
                      <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <SizePolicy>me,min</SizePolicy>
                        <Children>
                          <Template src="skins:LateNight/decks/deck_pads_compact.xml" />
                        </Children>
                        <Connection>
                          <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="ChanNum"/></ConfigKey>
                          <Transform><Not/></Transform>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </WidgetGroup>
                      <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <SizePolicy>me,min</SizePolicy>
                        <Children>
                          <Template src="skins:LateNight/decks/deck_gridedit_compact.xml" />
                        </Children>
                        <Connection>
                          <ConfigKey persist="true">[Skin],show_grid_edit_<Variable name="ChanNum"/></ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>

                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- DeckRows2345 -->

          <!-- CUSTOM (Rekordbox layout): the pitch fader (rate_controls_compact)
               was removed (pitch is controlled from the turntables) so the
               waveform spans the full width. The jog wheel + live BPM now sits
               in the transport row BELOW the waveform (see
               row_5_transportLoopJump_compact.xml). -->

        </Children>
        <!-- This is supposed to reduce margin and eliminate the border that
          touches the optional VU meters when they're visible.
          Unfortunately it is buggy and works only for the state that is
          active while the skin is loaded. If the highlight value changes the
          layout may be screwed and inner widgets overlap the outer border.. wtf?
        <Connection>
          <ConfigKey persist="true">[LateNight],show_vumeters_compact</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection> -->
      </WidgetGroup><!-- DeckCompactN -->

    </Children>
  </WidgetGroup>
</Template>
